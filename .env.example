# Copy to .env and fill in. .env is gitignored; this file is not.

# --- Model access (§10) -------------------------------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Model pins. Verify slugs against https://openrouter.ai/api/v1/models — the
# catalogue moves. LLMRegistry.validate() refuses to start if the judge and the
# agent share a vendor prefix (§14.2).
MODEL_AGENT=anthropic/claude-sonnet-5
MODEL_ROUTER=anthropic/claude-haiku-4-5
MODEL_JUDGE=google/gemini-2.5-pro
MODEL_PERSONA=google/gemini-2.5-pro

# --- Database ----------------------------------------------------------------
POSTGRES_DB=fibrapunto
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Bootstrap superuser — used for migrations and the reset script only.
POSTGRES_USER=fibrapunto_owner
POSTGRES_PASSWORD=change-me-owner

# The two principals of §8. The agent never connects as anything but the first.
AGENT_DB_USER=fibrapunto_agent
AGENT_DB_PASSWORD=change-me-agent
PLATFORM_DB_USER=fibrapunto_platform
PLATFORM_DB_PASSWORD=change-me-platform

# --- Billing stub (§7) -------------------------------------------------------
BILLING_BASE_URL=http://localhost:8081
BILLING_TIMEOUT_SECONDS=5.0
BILLING_BASE_LATENCY_MS=800
BILLING_LATENCY_JITTER_MS=300

# --- Credential store (§17.7) ------------------------------------------------
# Fernet key protecting secrets/credentials.enc.json. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIBRAPUNTO_MASTER_KEY=

# --- Privacy (§9) ------------------------------------------------------------
# See docs/DEVIATIONS.md — pre-redaction narrows the limitation §9 states.
REDACT_INBOUND=true
TRANSCRIPT_RETENTION_DAYS=30
