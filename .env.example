# Copy to .env and fill in. .env is gitignored; this file is not.

# --- Model access (§10) -------------------------------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Model pins. Verify slugs against https://openrouter.ai/api/v1/models — the
# catalogue moves. LLMRegistry.validate() refuses to start if the judge and the
# agent share a vendor prefix (§14.2).
MODEL_AGENT=anthropic/claude-sonnet-5
MODEL_ROUTER=anthropic/claude-haiku-4.5
MODEL_JUDGE=google/gemini-2.5-pro
MODEL_PERSONA=google/gemini-2.5-pro

# --- Database ----------------------------------------------------------------
POSTGRES_DB=fibrapunto
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Bootstrap superuser — used for migrations and the reset script only.
POSTGRES_USER=fibrapunto_owner
POSTGRES_PASSWORD=change-me-owner

# The two principals of §8. The agent never connects as anything but the first.
AGENT_DB_USER=fibrapunto_agent
AGENT_DB_PASSWORD=change-me-agent
PLATFORM_DB_USER=fibrapunto_platform
PLATFORM_DB_PASSWORD=change-me-platform

# --- Billing stub (§7) -------------------------------------------------------
BILLING_BASE_URL=http://localhost:8081
# The recommendation system (offers and their budget). Overridden in compose.
RECOMMENDATION_BASE_URL=http://localhost:8082
BILLING_TIMEOUT_SECONDS=5.0
BILLING_BASE_LATENCY_MS=800
BILLING_LATENCY_JITTER_MS=300

# --- Credential store (§17.7) ------------------------------------------------
# Fernet key protecting secrets/credentials.enc.json. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIBRAPUNTO_MASTER_KEY=

# --- Role access -------------------------------------------------------------
# One password per view, each opening on a sign-in form. Scripts may send the
# password as HTTP Basic with the role as the username (`operator`, `developer`,
# `analyst`). Empty means that view refuses every request. Demo gate only: in
# production each is a separate service behind SSO.
#   /operator  the cases queue and the customer's contact details; also the
#              admin routes
#   /console   the system trace, the live failure switches, the session metrics
#   /analyst   the aggregate metrics, the campaigns and the offers budget
OPERATOR_PASSWORD=
DEVELOPER_PASSWORD=
ANALYST_PASSWORD=

# --- Privacy (§9) ------------------------------------------------------------
# See docs/DEVIATIONS.md — pre-redaction narrows the limitation §9 states.
REDACT_INBOUND=true
TRANSCRIPT_RETENTION_DAYS=30

# --- Demo failure switches ---------------------------------------------------
# Lets the control strip switch the CRM, the colleagues, the model provider,
# the credential store and the trace store off and on (backend faults.py).
# Leave false outside a demo: when false, nothing can be switched off.
FAULT_INJECTION=true
